{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ritmera",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/ritmera/browser",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
